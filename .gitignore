# runtime
.venv/
__pycache__/
*.pyc

# local model weights (downloaded, NOT part of the repo)
models/
tools/llm/*.zip
tools/llm/llama-*/
# 本地推理二进制（llama.cpp CUDA 运行时，约 1.2 GB；由 tools/llm/start_llm.ps1 首次下载/解压）
tools/llm/llama/
tools/llm/cudart/

# runtime media caches / logs / recordings
media/
assets/raw/
# production/reports 里只留一件东西：交付要求里的 4 分钟演示录屏（git 不允许在被忽略的
# 目录里再 re-include 文件，所以父目录要逐层放行）
production/reports/*
!production/reports/demo/
production/reports/demo/*
!production/reports/demo/mira_demo_4min.mp4
logs/
production/session-state/
# dsh-studio 本地工具状态（不是交付物）
project.yaml
# archify / 其他本地工具的状态目录（不是交付物）
.archify/

# 素材工作区：备份/暂存/抠像中间产物不进货（默认位 char/*.webp 才是交付物）
app/static/assets/_backup*/
app/static/assets/_staging/
app/static/assets/_decontam/
app/static/assets/_preview/
# 呼吸帧已被 transform 呼吸取代（manifest 里 breath.deprecated=true），留盘做 A/B 但不进货
app/static/assets/char/breath_*.webp
app/static/assets/char/*.tmp
app/static/assets/char/manifest.json
app/static/assets/char/md5.txt

# v17：素材跟着卡走（cards/<id>/assets/，见 docs/CARD_ASSETS_LAYOUT_V17.md）。
# 同一批忽略规则跟着搬，另外补两条：迁移前的整棵备份、被下架的坏帧/原图。
app/static/assets.bak_v16/
cards/*/assets/char/manifest.json
cards/*/assets/char/md5.txt
cards/*/assets/char/*.tmp
cards/*/assets/char/breath_*.webp
cards/*/assets/char/_parked/
cards/*/assets/char/_raw_v15/
cards/*/assets/*/_backup*/
cards/*/assets/*/_staging/
cards/*/assets/*/_decontam/
cards/*/assets/*/_preview/

# 工作材料：第三方克隆、旧素材、AniSora 抽帧（几百 MB，不进仓库）
third_party/
assets/turn/
assets/legacy/

# OS / editor
Thumbs.db
.DS_Store
.vscode/
.idea/

# secrets
.env
*.key
